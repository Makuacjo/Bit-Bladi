generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  nameEn    String
  nameAr    String
  sort      Int        @default(0)
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     FoodItem[]
}

model FoodItem {
  id         String   @id @default(cuid())
  nameEn     String
  nameAr     String
  descEn     String   @default("") @db.VarChar(1000)
  descAr     String   @default("") @db.VarChar(1000)
  price      Int
  image      String   @default("")
  categoryId String
  available  Boolean  @default(true)
  visible    Boolean  @default(true)
  featured   Boolean  @default(false)
  popular    Boolean  @default(false)
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Promotion {
  id        String    @id @default(cuid())
  titleEn   String
  titleAr   String
  descEn    String    @default("") @db.VarChar(1000)
  descAr    String    @default("") @db.VarChar(1000)
  image     String    @default("")
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Testimonial {
  id      String  @id @default(cuid())
  name    String
  textEn  String  @db.VarChar(1000)
  textAr  String  @default("") @db.VarChar(1000)
  sort    Int     @default(0)
  enabled Boolean @default(true)
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  createdAt DateTime @default(now())
}

model Review {
  id           String    @id @default(cuid())
  customerName String
  rating       Int
  reviewText   String    @db.Text
  email        String?
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  approvedAt   DateTime?

  @@index([status])
  @@index([status, createdAt])
}

model Reservation {
  id                String   @id @default(cuid())
  code              String   @unique
  customerName      String
  customerPhone     String
  customerEmail     String
  date              String
  time              String
  guestCount        Int
  specialRequests   String   @default("") @db.VarChar(1000)
  status            String   @default("PENDING")
  preferredLanguage String   @default("en")
  assignedTable     String   @default("")
  emailStatus       String   @default("PENDING")
  whatsappStatus    String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([date])
  @@index([date, time])
  @@index([status, date])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Settings {
  id             String   @id @default("singleton")
  businessName   String   @default("Bit Bladi")
  currency       String   @default("KES")
  whatsappNumber String   @default("254798022831")
  content        String   @db.Text
  updatedAt      DateTime @updatedAt
}
