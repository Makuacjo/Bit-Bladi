# MySQL / MariaDB connection (Hostinger Web/Cloud, or local MySQL).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Hostinger example: mysql://u123_bitbladi:PASSWORD@localhost:3306/u123_bitbladi
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"

# Secret used to sign admin session cookies. MUST be changed in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-secret"

# Canonical public base URL — used for canonical/hreflang tags, robots.txt and
# sitemap.xml. Must be the production domain (https://bitbladi.com), NOT a
# temporary Hostinger preview host. Hostinger hosts are ignored automatically.
SITE_URL="https://bitbladi.com"

# Optional: override seeded admin credentials (used only by `npm run db:seed`)
ADMIN_EMAIL="admin@bitbladi.com"
ADMIN_PASSWORD="bitbladi123"

# ── Reservation notifications (all OPTIONAL) ──
# The reservation system works fully without these; notifications are simply
# marked SKIPPED until configured. Never expose these to the browser.

# Resend transactional email (https://resend.com). RESERVATION_FROM_EMAIL must be
# a verified sender/domain. RESTAURANT_NOTIFICATION_EMAIL receives new-request alerts.
RESEND_API_KEY=""
RESERVATION_FROM_EMAIL="reservations@bitbladi.example.com"
RESTAURANT_NOTIFICATION_EMAIL="owner@bitbladi.example.com"

# Meta WhatsApp Cloud API. Free-form text works in the 24h service window / for
# test numbers; business-initiated messages need an approved template.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Base URL used in the restaurant's admin link inside notification emails.
APP_BASE_URL="https://bitbladi.example.com"
